# ========================================================
# NetGateway — Variables de Entorno / Environment Variables
# ========================================================

# Puerto del servidor NetGateway (por defecto: 3000)
PORT=3000

# Entorno de ejecución (production / development)
NODE_ENV=production

# OBLIGATORIO EN PRODUCCIÓN / MANDATORY IN PRODUCTION:
# Clave secreta para firmar tokens JWT y derivar llaves AES-256 en el Vault.
# IMPORTANTE: Si la clave contiene el símbolo '$', escápalo con '$$' en Docker Compose
# (ejemplo: Secreto$$Seguro2026) para evitar el warning 'variable is not set'.
JWT_SECRET="ColocaAquiUnaClaveSecretaMuyLargaYSegura2026!"

# --------------------------------------------------------
# NOTA SOBRE GEMINI_API_KEY:
# NetGateway NO requiere ni utiliza la API de Gemini para su
# funcionamiento. Esta variable solo viene predeterminada en
# la plantilla base de Google AI Studio, pero NO es necesaria
# para desplegar ni operar NetGateway en tu servidor.
# --------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"

